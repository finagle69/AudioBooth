+  /// True when the current audio output is a Bluetooth device (car stereo, headphones, speaker).
+  static var isBluetoothOutputActive: Bool {
+    AVAudioSession.sharedInstance().currentRoute.outputs.contains { output in
+      switch output.portType {
+      case .bluetoothA2DP, .bluetoothHFP, .bluetoothLE:
+        return true
+      default:
+        return false
+      }
+    }
+  }
+
+  /// Whether the system Now Playing info (lock screen, Control Center, Bluetooth/car displays)
+  /// should describe the whole book rather than the current chapter.
+  static func publishesFullBookTimeline(_ preferences: UserPreferences = .shared) -> Bool {
+    if preferences.showFullBookDuration { return true }
+    return preferences.bluetoothUsesFullBookTimeline && isBluetoothOutputActive
+  }
+
+  /// Whether the "time remaining" suffix should be left off the Now Playing title.
+  static func hidesRemainingInTitle(_ preferences: UserPreferences = .shared) -> Bool {
+    preferences.bluetoothHidesRemainingInTitle && isBluetoothOutputActive
+  }
