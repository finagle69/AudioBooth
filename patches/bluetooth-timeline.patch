@@ -74,6 +74,64 @@ final class NowPlayingManager {
     }
   }
 
+  // CUSTOM (Bluetooth / Car): the helpers below answer one question: "is the car the thing
+  // my audio is going to right now?" They are `static`, meaning you call them on the type
+  // (NowPlayingManager.isCarOutputActive()) without needing a specific player object.
+
+  /// Bluetooth outputs in the current audio route (car stereo, headphones, speaker).
+  // iOS keeps a "route": the list of places sound is currently sent. We keep only the entries
+  // whose port type is one of the three Bluetooth kinds (A2DP = music quality, HFP = phone-call
+  // quality, LE = low energy), and drop the phone speaker, wired headphones, and so on.
+  static var bluetoothOutputs: [AVAudioSessionPortDescription] {
+    AVAudioSession.sharedInstance().currentRoute.outputs.filter { output in
+      switch output.portType {
+      case .bluetoothA2DP, .bluetoothHFP, .bluetoothLE:
+        return true
+      default:
+        return false
+      }
+    }
+  }
+
+  /// Name of the Bluetooth device currently playing audio, if any.
+  // Used by the "Use Current Bluetooth Device" button. `.first?` is safe when the list is empty
+  // (the result is just nil, meaning "no name").
+  static var currentBluetoothOutputName: String? {
+    bluetoothOutputs.first?.portName
+  }
+
+  /// True when audio is playing to a Bluetooth device that counts as "the car":
+  /// any Bluetooth device if no car name is set, otherwise one whose name contains it.
+  static func isCarOutputActive(_ preferences: UserPreferences = .shared) -> Bool {
+    // Step 1: no Bluetooth at all (phone speaker, wired) means it is not the car.
+    let outputs = bluetoothOutputs
+    guard !outputs.isEmpty else { return false }
+
+    // Step 2: if no car name is saved, any Bluetooth device counts (old behavior).
+    let filter = preferences.bluetoothCarDeviceName.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !filter.isEmpty else { return true }
+
+    // Step 3: otherwise only a device whose name contains your text counts. Ignores upper or
+    // lower case, so "tesla" matches "John's Tesla". AirPods and the Razer fail this test.
+    return outputs.contains { $0.portName.localizedCaseInsensitiveContains(filter) }
+  }
+
+  /// Whether the system Now Playing info (lock screen, Control Center, Bluetooth/car displays)
+  /// should describe the whole book rather than the current chapter.
+  static func publishesFullBookTimeline(_ preferences: UserPreferences = .shared) -> Bool {
+    // The app's original "show full book duration" setting always wins. Otherwise use the
+    // whole book only when our new toggle is on AND the car is the active output.
+    if preferences.showFullBookDuration { return true }
+    return preferences.bluetoothUsesFullBookTimeline && isCarOutputActive(preferences)
+  }
+
+  /// Whether the "time remaining" suffix should be left off the Now Playing title.
+  static func hidesRemainingInTitle(_ preferences: UserPreferences = .shared) -> Bool {
+    // Both must be true: the toggle is on, and the car is the active output. This is what
+    // stops the car screen from redrawing every minute as the countdown changes.
+    preferences.bluetoothHidesRemainingInTitle && isCarOutputActive(preferences)
+  }
